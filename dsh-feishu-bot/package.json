{
  "name": "@zyuer/dsh-feishu-bot",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness plugin for Feishu bot conversations.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.map",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown --config tsdown.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "@larksuiteoapi/node-sdk": "1.73.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-api-remotes": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.7",
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session-persistence": "0.1.0-rc.7",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.7",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-api-remotes": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.7",
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session-persistence": "0.1.0-rc.7",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.7",
    "@types/node": "^22.20.0",
    "@types/react": "18.3.28",
    "react": "^18.3.1",
    "tsdown": "0.22.2",
    "typescript": "^6.0.3",
    "vitest": "4.1.8"
  }
}
